{
  "schema_version": "1.0",
  "name": "GENEB \u2014 Genomic Embedding Benchmark",
  "harness_version": "GENEB-0.1.0",
  "regimes": [
    "full",
    "10shot",
    "1shot"
  ],
  "metrics": [
    "MCC",
    "Acc",
    "F1"
  ],
  "primary_metric": "MCC",
  "protocol": {
    "probe": "logistic_regression",
    "logreg": {
      "max_iter": 1000,
      "n_jobs": 32
    },
    "seeds": [
      13,
      17,
      42,
      123,
      997
    ],
    "pooling": "mean over tokens (model-specific, see extractors/)",
    "few_shot_k": [
      1,
      10
    ],
    "note": "Linear probe on precomputed embeddings. Identical train/test splits for every model; see dataset revision below."
  },
  "dataset": {
    "repo_id": "darlednik/geneb-tasks",
